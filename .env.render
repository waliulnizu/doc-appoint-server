# Render environment file for doc-appoint-server
# Copy or upload this file to Render and replace placeholders with your real values.

PORT=5000
MONGO_URI=<YOUR_MONGODB_URI>
DB_NAME=docAppoint

# Your frontend app URL on Vercel
BETTER_AUTH_URL=https://doc-appoint-client-sepia.vercel.app
CLIENT_URL=https://doc-appoint-client-sepia.vercel.app

# Google OAuth credentials (if used)
GOOGLE_CLIENT_ID=<YOUR_GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<YOUR_GOOGLE_CLIENT_SECRET>

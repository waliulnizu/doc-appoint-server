# DocAppoint Server - Environment Variables
# Copy this file to .env for local development

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Server Port (Local development only)
# Render sets PORT automatically - DO NOT SET on Render dashboard
PORT=5000

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# MongoDB Atlas Connection String
# Get from MongoDB Atlas Dashboard → Connect → Drivers
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<cluster>
MONGO_URI=mongodb+srv://username:password@cluster0.mongodb.net/?appName=Cluster0

# Database Name
DB_NAME=docappoint

# ===========================================
# BETTER AUTH CONFIGURATION
# ===========================================

# Better Auth Callback Base URL
# IMPORTANT: Set to CLIENT URL (frontend) when using Next.js rewrites
# Local: http://localhost:3000
# Production: https://doc-appoint-client-sepia.vercel.app
BETTER_AUTH_URL=http://localhost:3000

# Frontend Origin for CORS & trustedOrigins
# Must match your deployed frontend URL exactly
# Local: http://localhost:3000
# Production: https://doc-appoint-client-sepia.vercel.app
CLIENT_URL=http://localhost:3000

# Better Auth Secret - Generate with: openssl rand -base64 32
# NEVER expose this to the client! Keep it secure.
# Must be at least 32 characters
BETTER_AUTH_SECRET=your-super-secret-key-generate-with-openssl-rand-base64-32

# ===========================================
# GOOGLE OAUTH (Optional)
# ===========================================

# Get from Google Cloud Console → APIs & Services → Credentials
# OAuth 2.0 Client ID (Web application)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ===========================================
# REDIRECT URIS FOR GOOGLE OAUTH
# ===========================================

# Local Development:
# http://localhost:3000/api/auth/callback/google

# Production:
# https://doc-appoint-client-sepia.vercel.app/api/auth/callback/google

# ===========================================
# NOTES
# ===========================================
# - BETTER_AUTH_URL and CLIENT_URL should be the SAME (frontend URL)
#   because Next.js rewrites proxy /api/auth/* to this server
# - On Render: Do NOT set PORT - Render assigns it automatically
# - On Render: Set BETTER_AUTH_URL and CLIENT_URL to your Vercel URL
# - Generate BETTER_AUTH_SECRET: openssl rand -base64 32
# - Never commit .env file to version control